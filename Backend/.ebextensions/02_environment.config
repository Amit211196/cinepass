option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    SPRING_JPA_HIBERNATE_DDL_AUTO: update
    SPRING_DATASOURCE_URL: jdbc:postgresql://cinepass-db.XXXXX.us-east-1.rds.amazonaws.com:5432/cinepass
    SPRING_DATASOURCE_USERNAME: cinepassadmin
    SPRING_DATASOURCE_PASSWORD: YourSecurePassword123!
    SPRING_DATASOURCE_DRIVER_CLASS_NAME: org.postgresql.Driver
    SPRING_JPA_DATABASE_PLATFORM: org.hibernate.dialect.PostgreSQL10Dialect
    JAVA_TOOL_OPTIONS: -Xmx512m -Xms256m
    SERVER_PORT: 8080
    SERVER_SERVLET_CONTEXT_PATH: /api

# IMPORTANT: Update the values below with your actual RDS endpoint and credentials
# SPRING_DATASOURCE_URL: jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/cinepass
# SPRING_DATASOURCE_USERNAME: Your RDS username
# SPRING_DATASOURCE_PASSWORD: Your RDS password

# To update these after deployment:
# eb setenv SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/cinepass

