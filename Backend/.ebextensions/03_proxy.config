container_commands:
  01_migrate:
    command: "java -jar /var/app/current/app.jar"
    leader_only: true
    environment:
      SPRING_JPA_HIBERNATE_DDL_AUTO: "update"

commands:
  01_add_security_headers:
    command: |
      cat > /etc/apache2/conf.d/security_headers.conf << 'EOF'
      # Security headers
      Header set X-Content-Type-Options "nosniff"
      Header set X-Frame-Options "DENY"
      Header set X-XSS-Protection "1; mode=block"
      Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

      # CORS headers for frontend
      Header set Access-Control-Allow-Origin "https://YOUR-CLOUDFRONT-DOMAIN.cloudfront.net"
      Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
      Header set Access-Control-Allow-Headers "Content-Type, Authorization"
      EOF
    ignoreErrors: true

files:
  "/etc/apache2/conf.d/proxy_backend.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      <VirtualHost *:80>
        ProxyPreserveHost On
        ProxyPass / http://127.0.0.1:8080/
        ProxyPassReverse / http://127.0.0.1:8080/
      </VirtualHost>

